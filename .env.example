# Environment Variables Template for KTU Voting Application
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Database Configuration
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=jdbc:postgresql://localhost:5432/ktuvoting
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password_here

# Authentication PINs (Required - No defaults for security)
ADMIN_PIN=your_admin_pin_here
USER_PIN=your_user_pin_here

# Optional: Redis Configuration (for caching in production)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional: Server Configuration
# PORT=8080
# JPA_DDL_AUTO=validate

# Optional: Cache Configuration
# CACHE_TYPE=simple
